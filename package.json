{
  "name": "hydrogen-ui-monorepo",
  "private": true,
  "version": "2.0.0",
  "description": "Monorepo for HydrogenUI: library and docs",
  "author": {
    "name": "Miners Online",
    "website": "https://minersonline.uk/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miners-online/HydrogenUI.git"
  },
  "bugs": {
    "url": "https://github.com/miners-online/HydrogenUI/issues"
  },
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "npm install",
    "build:lib": "npm run -w @miners-online/hydrogen-ui build",
    "build:docs": "npm run -w @miners-online/hydrogen-ui-docs storybook:build",
    "build": "npm run build:lib && npm run build:docs",
    "storybook": "npm run -w @miners-online/hydrogen-ui-docs storybook",
    "clean": "rimraf packages/*/dist"
  }
}
