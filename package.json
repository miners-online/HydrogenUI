{
  "name": "@miners-online/hydrogen-ui",
  "version": "1.2.0",
  "description": "A UI design system containing extra components for Microsoft Fluent UI. ",
  "author": {
    "name": "Miners Online",
    "website": "https://minersonline.uk/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miners-online/HydrogenUI.git"
  },
  "bugs": {
    "url": "https://github.com/miners-online/HydrogenUI/issues"
  },
  "license": "MIT",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build:ts": "rollup -c",
    "build": "sass src/scss/index.scss dist/css/index.css --style=compressed && cp -r src/scss dist/scss && npm run build:ts"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.1.6",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "rollup": "^4.20.0",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-typescript2": "^0.36.0",
    "sass": "^1.82.0",
    "semantic-release": "^24.0.0",
    "typescript": "^5.5.4"
  },
  "resolutions": {
    "jackspeak": "2.1.1"
  },
  "homepage": "https://github.com/miners-online/HydrogenUI#readme"
}
